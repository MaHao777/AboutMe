---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import '../styles/global.css';
import { getLocale, localePath, translator } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  section?: 'home' | 'work' | 'life';
}

const { title, description, image = '/og-default.svg', type = 'website', section = 'home' } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const pageTitle = `${title} | ${t('马浩', 'Ma Hao')}`;
const defaultImage = t('/og-default.svg', '/og-default-en.svg');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image === '/og-default.svg' ? defaultImage : image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={t('zh-CN', 'en')} data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(localePath(Astro.url.pathname, 'zh'), canonical)} />
    <link rel="alternate" hreflang="en" href={new URL(localePath(Astro.url.pathname, 'en'), canonical)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={section === 'life' ? '#f5edd8' : '#f5f8fc'} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={t('马浩', 'Ma Hao')} />
    <meta property="og:locale" content={t('zh_CN', 'en_US')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light'
          ? saved
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('跳转到正文', 'Skip to content')}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <Motion />
  </body>
</html>
