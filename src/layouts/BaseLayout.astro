---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import CosmicBackdrop from '../components/CosmicBackdrop.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { getLocale, localePath, translator } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  section?: 'home' | 'work' | 'life';
}

const { title, description, image = '/og-default.svg', type = 'website', section = 'home' } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const pageTitle = `${title} | ${t('马浩', 'Ma Hao')}`;
const defaultImage = t('/og-default.svg', '/og-default-en.svg');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image === '/og-default.svg' ? defaultImage : image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={t('zh-CN', 'en')} data-section={section} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(localePath(Astro.url.pathname, 'zh'), canonical)} />
    <link rel="alternate" hreflang="en" href={new URL(localePath(Astro.url.pathname, 'en'), canonical)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c111b" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={t('马浩', 'Ma Hao')} />
    <meta property="og:locale" content={t('zh_CN', 'en_US')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        if (window.__cosmosThemeBound) return;
        window.__cosmosThemeBound = true;
        try {
          const saved = localStorage.getItem('theme');
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
        const updateThemeColor = () => document.querySelector('meta[name="theme-color"]')?.setAttribute('content',
          document.documentElement.dataset.theme === 'dark' ? '#0c111b' : '#f7f5ef');
        // Copy the current choice before swapping HTML, including when storage is unavailable.
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
        document.addEventListener('astro:after-swap', updateThemeColor);
        updateThemeColor();
      })();
    </script>
  </head>
  <body>
    <CosmicBackdrop />
    <a class="skip-link" href="#main">{t('跳转到正文', 'Skip to content')}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <Motion />
  </body>
</html>

<script>
  document.addEventListener('astro:before-swap', (event) => {
    if (document.querySelector('[data-planet-scene]') || event.newDocument.querySelector('[data-planet-scene]')) {
      // The live canvas moves between layouts; snapshots would briefly duplicate it.
      void event.viewTransition.ready.catch(() => {});
      event.viewTransition.skipTransition();
    }
  });
</script>
