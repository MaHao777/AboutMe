---
import { ArrowUpRight, Download, GitBranch, Mail, MoveUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, experiences } from '../data/profile';
import { skillGroups } from '../data/skills';
import { achievements } from '../data/achievements';
import { links } from '../data/links';
import { getPublicProjects } from '../lib/content';

const projects = await getPublicProjects();
---

<BaseLayout title="Professional" description="马浩的项目、研究与工程经历。关注事件视觉、软件开发与个人工具。">
  <section class="page-hero work-hero container">
    <p class="eyebrow"><span class="live-dot"></span> PROFESSIONAL / PORTFOLIO</p>
    <div class="page-hero-main"><h1>把问题看清，<br /><span>再把想法做出来<span class="accent">.</span></span></h1><span class="hero-aside">RESEARCH<br />DEVELOPMENT<br />EXPLORATION</span></div>
    <div class="page-hero-bottom"><p>{profile.introduction}</p><span>{profile.school} <span class="divider-slash">/</span> {profile.location}</span></div>
  </section>

  <section class="section-space section-rule container" id="introduction">
    <SectionHeading index="01" title="Introduction" />
    <div class="intro-grid"><p class="statement">我喜欢把<span class="text-blue">研究中的问题</span>转化为可验证的工具，也喜欢把<span class="text-blue">工程中的细节</span>做扎实。</p><div class="intro-side"><p>从事件相机与波前重构，到桌面应用、通信工具和 AI Agent，我在不同场景中寻找清晰的问题定义与可靠的实现路径。</p><a class="text-link" href="#projects">查看项目 <MoveUpRight size={17} /></a></div></div>
  </section>

  <section class="section-space section-rule container" id="projects">
    <SectionHeading index="02" title="Selected Projects" intro="研究原型、开源工具与产品尝试。" />
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>

  <section class="section-space section-rule container" id="experience">
    <SectionHeading index="03" title="Research / Experience" intro="在真实任务里学习研究方法与工程协作。" />
    <div class="experience-list">{experiences.filter((item) => item.published).map((item) => <article class="experience-row"><span class="experience-period">{item.period}</span><div><p class="eyebrow">{item.place}</p><h3>{item.title}</h3><p>{item.description}</p></div><ArrowUpRight size={19} stroke-width={1.5} /></article>)}</div>
  </section>

  <section class="section-space section-rule container" id="skills">
    <SectionHeading index="04" title="Skills & Tools" intro="按使用场景整理；熟练程度以具体项目为准。" />
    <div class="skill-grid">{skillGroups.filter((group) => group.published).map((group, index) => <div class="skill-card"><span class="small-index">0{index + 1}</span><h3>{group.title}</h3><div class="tags">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
  </section>

  <section class="section-space section-rule container" id="achievements">
    <SectionHeading index="05" title="Achievements" intro="经过整理、可公开展示的部分成果。" />
    <div class="achievement-list">{achievements.filter((item) => item.published).map((item) => <article class="achievement-row"><span>{item.year}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}</div>
  </section>

  <section class="section-space section-rule container" id="resume">
    <SectionHeading index="06" title="Resume / GitHub" />
    <div class="resource-grid">
      <div class="resource-card"><span class="resource-icon"><Download size={22} stroke-width={1.5} /></span><h3>简历</h3><p>正式版简历正在整理；项目和经历已在本页展示。</p>{profile.resumeUrl && <a class="text-link" href={profile.resumeUrl} download>下载 PDF <ArrowUpRight size={17} /></a>}</div>
      <a class="resource-card resource-link" href={links.github} target="_blank" rel="noopener noreferrer"><span class="resource-icon"><GitBranch size={22} stroke-width={1.5} /></span><h3>GitHub <ArrowUpRight size={18} /></h3><p>查看公开仓库、代码和项目更新。</p><span class="text-link">github.com/{links.githubLabel} <ArrowUpRight size={17} /></span></a>
    </div>
  </section>

  <section class="contact-band" id="contact"><div class="container contact-inner"><div><p class="eyebrow">07 / CONTACT</p><h2>有问题想一起探索？</h2><p>欢迎从 GitHub 开始交流项目与想法。</p></div>{profile.email ? <a class="button button-primary" href={`mailto:${profile.email}`}><Mail size={18} /> 发送邮件</a> : <a class="button button-primary" href={links.github} target="_blank" rel="noopener noreferrer"><GitBranch size={18} /> 在 GitHub 找到我 <ArrowUpRight size={18} /></a>}</div></section>
</BaseLayout>
