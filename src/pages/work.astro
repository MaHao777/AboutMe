---
import { ArrowUpRight, Download, GitBranch, Mail } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, experiences, featuredResults } from '../data/profile';
import { skillGroups } from '../data/skills';
import { achievements } from '../data/achievements';
import { links } from '../data/links';
import { getPublicProjects } from '../lib/content';

const projects = await getPublicProjects();
---

<BaseLayout title="Professional" description="马浩的研究与工程成果：波前数据平台、条纹闭环锁定、TraceFormer 事件小目标检测与车辆通信软件。" section="work">
  <section class="work-intro container">
    <div class="work-intro-copy">
      <p class="eyebrow">PROFESSIONAL · RESEARCH & ENGINEERING</p>
      <h1>从光学实验，<br />到能用的软件。</h1>
      <p>{profile.introduction}</p>
      <div class="hero-actions"><a class="button button-primary" href="#projects">看看我做过什么 <ArrowUpRight size={18} /></a><span>{profile.name} / {profile.school}</span></div>
    </div>
    <aside class="results-sheet" aria-label="代表成果">
      <p class="sheet-title">一些已经留下的结果 <span>SELECTED OUTCOMES</span></p>
      {featuredResults.filter((item) => item.published).map((item) => <a class="result-item" href={item.href}><strong>{item.value}</strong><div><h2>{item.label}</h2><p>{item.detail}</p></div><ArrowUpRight size={18} /></a>)}
      <span class="sheet-note">点击一项成果，阅读它背后的工作。</span>
    </aside>
  </section>

  <nav class="chapter-nav container" aria-label="本页章节"><a href="#projects">研究与项目</a><a href="#experience">实践经历</a><a href="#achievements">奖项与成果</a><a href="#skills">能力与工具</a><a href="#resume">简历与联系</a></nav>

  <section class="section-space container" id="projects">
    <SectionHeading index="01" title="研究与项目" label="WORK, WITH OUTCOMES" intro="每个项目先呈现交付与结果；展开卡片可看我的职责，详情页再讲问题与方法。" />
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="section-space section-rule container" id="experience">
    <SectionHeading index="02" title="走进实验室，也走进现场" label="RESEARCH / EXPERIENCE" />
    <div class="experience-list">{experiences.filter((item) => item.published).map((item) => <article class="experience-row"><span class="experience-period">{item.period}</span><div><p class="eyebrow">{item.place}</p><h3>{item.title}</h3><p>{item.description}</p><details class="experience-disclosure"><summary>查看具体交付</summary><ul>{item.outcomes.map((outcome) => <li>{outcome}</li>)}</ul><a class="text-link" href={item.href}>阅读项目经历 <ArrowUpRight size={15} /></a></details></div></article>)}</div>
  </section>

  <section class="section-space section-rule container" id="achievements">
    <SectionHeading index="03" title="奖项与成果" label="RECOGNITION" intro="荣誉属于具体作品和团队，个人贡献在对应项目中展开。" />
    <div class="award-grid">{achievements.filter((item) => item.published).map((item) => <article class="award-card"><span class="award-year">{item.year} · {item.label}</span><h3>{item.result}</h3><details><summary>奖项详情</summary><p>{item.title}</p><p>{item.detail}</p></details>{item.href && <a class="text-link" href={item.href}>看获奖作品 <ArrowUpRight size={16} /></a>}</article>)}</div>
  </section>

  <section class="section-space section-rule container" id="skills">
    <SectionHeading index="04" title="能力，长在实践里" label="SKILLS & TOOLS" intro="这些工具用于上面的具体项目，熟练程度以实际工作为准。" />
    <div class="skill-grid">{skillGroups.filter((group) => group.published).map((group) => <div class="skill-card"><h3>{group.title}</h3><div class="tags">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
  </section>

  <section class="section-space section-rule container" id="resume">
    <SectionHeading index="05" title="继续了解，或聊一聊" label="RESUME / GITHUB / CONTACT" />
    <div class="resource-grid"><div class="resource-card"><Download size={22} stroke-width={1.5} /><h3>简历</h3><p>项目和经历可在本站阅读，PDF 版简历正在整理。</p>{profile.resumeUrl && <a class="text-link" href={profile.resumeUrl} download>下载 PDF <ArrowUpRight size={16} /></a>}</div><a class="resource-card" href={links.github} target="_blank" rel="noopener noreferrer"><GitBranch size={22} stroke-width={1.5} /><h3>GitHub</h3><p>公开代码、工具和项目更新。</p><span class="text-link">{links.githubLabel} <ArrowUpRight size={16} /></span></a></div>
    <div class="contact-inner"><div><h2>有一个值得探索的问题？</h2><p>欢迎交流研究、工程与有意思的小工具。</p></div>{profile.email ? <a class="button button-primary" href={`mailto:${profile.email}`}><Mail size={17} /> 发送邮件</a> : <a class="button button-primary" href={links.github} target="_blank" rel="noopener noreferrer">从 GitHub 开始交流 <ArrowUpRight size={17} /></a>}</div>
  </section>
</BaseLayout>
