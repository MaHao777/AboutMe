---
import { ArrowUpRight, Download, GitBranch } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtStudy from '../components/ArtStudy.astro';
import ResultStrip from '../components/ResultStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, experiences } from '../data/profile';
import { presentation } from '../data/presentation';
import { skillGroups } from '../data/skills';
import { achievements } from '../data/achievements';
import { scholarships, languageScores } from '../data/resume';
import { links } from '../data/links';
import { getPublicProjects } from '../lib/content';
const projects = await getPublicProjects();
---

<BaseLayout title="Professional" description="马浩的研究与工程成果：波前数据平台、条纹闭环锁定、TraceFormer 微弱目标检测与车辆通信软件。" section="work">
  <section class="collection-hero work-hero container">
    <div class="collection-copy hero-arrive">
      <p class="eyebrow">01 / PROFESSIONAL</p>
      <h1>{presentation.work.heading[0]}<br /><span>{presentation.work.heading[1]}</span></h1>
      <div class="hero-bottom"><p>{presentation.work.caption}</p><a class="circle-link" href="#projects" aria-label="浏览研究与项目"><ArrowUpRight size={24} stroke-width={1.3} /></a></div>
    </div>
    <div class="hero-artwork hero-arrive"><ArtStudy kind="work" id="work-hero" /><span class="art-caption">FORM / LIGHT / POSSIBILITY</span></div>
  </section>
  <ResultStrip />

  <section class="section-space container" id="projects">
    <div class="collection-heading" data-reveal><p class="eyebrow">SELECTED WORK / {String(projects.length).padStart(2, '0')}</p><h2>{presentation.work.projects}</h2><span>研究 · 工程 · 工具</span></div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section class="profile-index container" aria-label="更多职业背景" data-reveal>
    <details class="index-disclosure" id="experience">
      <summary><span class="index-number">01</span><span>关于与经历</span><span class="index-hint">BACKGROUND</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary>
      <div class="index-body"><p class="profile-introduction">{profile.introduction}</p><div class="experience-list">{experiences.filter((item) => item.published).map((item) => <article class="experience-row"><span class="experience-period">{item.period}</span><div><p class="eyebrow">{item.place}</p><h3>{item.title}</h3><p>{item.description}</p><ul>{item.outcomes.map((outcome) => <li>{outcome}</li>)}</ul><a class="text-link" href={item.href}>项目详情 <ArrowUpRight size={15} /></a></div></article>)}</div></div>
    </details>
    <details class="index-disclosure" id="achievements">
      <summary><span class="index-number">02</span><span>奖项与成果</span><span class="index-hint">RECOGNITION</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary>
      <div class="index-body award-list">{achievements.filter((item) => item.published).map((item) => <article class="award-row"><span>{item.year}</span><div><h3>{item.result}</h3><p>{item.title}</p><p>{item.detail}</p></div>{item.href && <a class="circle-link" href={item.href} aria-label={`查看${item.label}获奖作品`}><ArrowUpRight size={22} stroke-width={1.3} /></a>}</article>)}</div>
    </details>
    <details class="index-disclosure" id="skills">
      <summary><span class="index-number">03</span><span>能力与工具</span><span class="index-hint">TOOLKIT</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary>
      <div class="index-body skill-grid">{skillGroups.filter((group) => group.published).map((group) => <div class="skill-card"><h3>{group.title}</h3><div class="tags">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
    </details>
    <details class="index-disclosure" id="resume">
      <summary><span class="index-number">04</span><span>简历与代码</span><span class="index-hint">MORE</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary>
      <div class="index-body">
        <div class="resume-overview">
          <section class="resume-qualification" aria-labelledby="scholarship-heading"><h3 id="scholarship-heading">奖学金</h3><ul class="scholarship-list">{scholarships.filter((item) => item.published).map((item) => <li><span>{item.period}</span><strong>{item.title}</strong></li>)}</ul></section>
          <section class="resume-qualification" aria-labelledby="language-heading"><h3 id="language-heading">英语成绩</h3><dl class="language-scores">{languageScores.filter((item) => item.published).map((item) => <div><dt><span>{item.code}</span>{item.title}</dt><dd><strong>{item.score}</strong><span>分</span></dd><time datetime={item.date}>{item.dateLabel}</time></div>)}</dl></section>
        </div>
        <div class="resource-grid"><div class="resource-card"><Download size={22} stroke-width={1.5} /><h3>简历</h3>{profile.resumeUrl ? <a class="text-link" href={profile.resumeUrl} download>下载 PDF <ArrowUpRight size={16} /></a> : <p>PDF 版正在整理。</p>}</div><a class="resource-card" href={links.github} target="_blank" rel="noopener noreferrer"><GitBranch size={22} stroke-width={1.5} /><h3>GitHub</h3><span class="text-link">{links.githubLabel} <ArrowUpRight size={16} /></span></a></div>
      </div>
    </details>
  </section>
</BaseLayout>
