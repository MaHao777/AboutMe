---
import { render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, GitBranch } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProjects, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, role, technologies, cover, coverAlt, coverCaption, gallery, outcome, highlights, github, paper, demo, status } = project.data;
const statusLabel = { ongoing: '进行中', completed: '已完成', archived: '已归档' }[status as 'ongoing' | 'completed' | 'archived'];
---

<BaseLayout title={title} description={description} image={cover} type="article" section="work">
  <article class="detail-page container">
    <a href="/work#projects" class="back-link"><ArrowLeft size={17} /> 返回项目列表</a>
    <div class="detail-head"><div><p class="eyebrow">PROJECT / {statusLabel}</p><h1>{title}</h1><p class="detail-outcome">{outcome}</p><p class="detail-description">{description}</p></div><span class="detail-date">{formatDate(date)}</span></div>
    <div class="detail-highlights">{highlights.map((item: { title: string; description: string }) => <div><h2>{item.title}</h2><p>{item.description}</p></div>)}</div>
    {cover && <figure class="detail-cover"><img src={cover} alt={coverAlt} /><figcaption>{coverCaption}</figcaption></figure>}
    <div class="detail-grid"><aside class="detail-sidebar"><div><span>MY ROLE</span><p>{role}</p></div><div><span>TECHNOLOGIES</span><div class="tags">{technologies.map((tech: string) => <span>{tech}</span>)}</div></div><div class="detail-links">{github && <a href={github} target="_blank" rel="noopener noreferrer"><GitBranch size={17} /> GitHub <ArrowUpRight size={16} /></a>}{paper && <a href={paper} target="_blank" rel="noopener noreferrer">Paper <ArrowUpRight size={16} /></a>}{demo && <a href={demo} target="_blank" rel="noopener noreferrer">Demo <ArrowUpRight size={16} /></a>}</div></aside><div class="prose"><Content /></div></div>
    {gallery.length > 0 && <section class="project-gallery" aria-label="项目结果图片"><h2>看见结果</h2>{gallery.map((item: { src: string; alt: string; caption: string }) => <figure><a href={item.src} target="_blank" rel="noopener noreferrer" aria-label="在新窗口查看完整图片"><img src={item.src} alt={item.alt} loading="lazy" /></a><figcaption>{item.caption}</figcaption></figure>)}</section>}
    <a href="/work#projects" class="end-link"><ArrowLeft size={17} /> 查看更多项目</a>
  </article>
</BaseLayout>
