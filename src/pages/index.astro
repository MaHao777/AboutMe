---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtStudy from '../components/ArtStudy.astro';
import ResultStrip from '../components/ResultStrip.astro';
import { profile } from '../data/profile';
import { presentation } from '../data/presentation';
---

<BaseLayout title="首页" description="马浩的研究、工程作品与生活笔记。波前数据平台、条纹锁定、微弱目标检测与个人工具。">
  <section class="home-gallery container" aria-label="认识马浩">
    <div class="home-masthead">
      <h1 class="name-display hero-arrive">{profile.englishName}<span class="name-period">.</span></h1>
      <p class="masthead-caption hero-arrive">{presentation.home.caption}<span>苏州大学</span></p>
    </div>
    <div class="entry-gallery">
      <a class="gallery-entry gallery-work hero-arrive" href="/work">
        <span class="entry-index">01 / WORK</span>
        <ArtStudy kind="work" id="home-work" />
        <div class="entry-title"><div><span>{presentation.home.work}</span><h2>Professional</h2></div><span class="round-arrow"><ArrowUpRight size={27} stroke-width={1.2} /></span></div>
      </a>
      <a class="gallery-entry gallery-life hero-arrive" href="/life">
        <span class="entry-index">02 / LIFE</span>
        <ArtStudy kind="life" id="home-life" />
        <div class="entry-title"><div><span>{presentation.home.life}</span><h2>Personal</h2></div><span class="round-arrow"><ArrowUpRight size={27} stroke-width={1.2} /></span></div>
      </a>
    </div>
  </section>
  <ResultStrip />
</BaseLayout>
