---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtStudy from '../components/ArtStudy.astro';
import ProfileStrip from '../components/ProfileStrip.astro';

import { getSiteData } from '../data/localized';
import { getLocale, localePath, translator } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const { presentation } = getSiteData(locale);
---

<BaseLayout title={t('首页', 'Home')} description={t('马浩的研究、工程作品与生活笔记。波前数据平台、条纹锁定、微弱目标检测与个人工具。', 'Ma Hao’s research, engineering projects, and writing on everyday life.')}>
  <section class="home-gallery container" aria-label={t('认识马浩', 'Meet Ma Hao')}>
    <div class="home-masthead">
      <h1 class="name-display hero-arrive"><span class="welcome-line">Welcome to my</span><span class="cosmos-word">COSMOS<span class="cosmos-spark" aria-hidden="true">✦</span></span></h1>
      <p class="masthead-caption hero-arrive">{presentation.home.caption}</p>
    </div>
    <div class="entry-gallery">
      <a class="gallery-entry gallery-work hero-arrive" href={localePath('/work', locale)}>
        <ArtStudy kind="work" id="home-work" />
        <div class="entry-title"><h2>{presentation.home.work}</h2><span class="round-arrow"><ArrowUpRight size={25} stroke-width={1.3} /></span></div>
      </a>
      <a class="gallery-entry gallery-life hero-arrive" href={localePath('/life', locale)}>
        <ArtStudy kind="life" id="home-life" />
        <div class="entry-title"><h2>{presentation.home.life}</h2><span class="round-arrow"><ArrowUpRight size={25} stroke-width={1.3} /></span></div>
      </a>
    </div>
  </section>
  <ProfileStrip />
</BaseLayout>
