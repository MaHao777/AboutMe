---
import { render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localePath, translator } from '../../lib/i18n';
import { getPublicNotes, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getPublicNotes();
  return notes.filter((note) => !note.data.externalUrl).map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, date, category, readingMinutes } = note.data;
---

<BaseLayout title={title} description={description} type="article" section="life">
  <article class="detail-page note-detail container">
    <a href={localePath('/life#notes', locale)} class="back-link"><ArrowLeft size={17} />{t(' 返回文章列表', ' Back to writing')}</a>
    <div class="note-head"><p class="eyebrow">{t('笔记', 'FIELD NOTES')} / {category}</p><h1>{title}<span class="accent">.</span></h1><p>{description}</p><div class="note-meta"><span>{formatDate(date, locale)}</span>{readingMinutes && <span>{t(`约 ${readingMinutes} 分钟阅读`, `${readingMinutes} min read`)}</span>}</div></div>
    <div class="prose note-prose"><Content /></div>
    <a href={localePath('/life#notes', locale)} class="end-link"><ArrowLeft size={17} />{t(' 返回所有文章', ' All writing')}</a>
  </article>
</BaseLayout>
