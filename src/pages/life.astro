---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeCollage from '../components/LifeCollage.astro';
import HoverDisclosure from '../components/HoverDisclosure.astro';

import { getPublicNotes, formatDate } from '../lib/content';
import { getSiteData } from '../data/localized';
import { getLocale, localePath, translator, contentSlug } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const notes = await getPublicNotes(locale);
const { profile, interests, timeline, presentation } = getSiteData(locale);
---

<BaseLayout title={t('生活与文字', 'Life & Writing')} description={t('马浩的生活拾页：音乐、运动、影像与经过整理的公开笔记。', 'Pages from everyday life: music, sport, photography, and public writing.')} section="life">
  <section class="editorial-page-hero life-page-hero container">
    <div class="collection-copy hero-arrive"><h1>{presentation.life.heading}</h1><div class="hero-bottom"><p>{presentation.life.caption}</p><a class="circle-link" href="#notes" aria-label={t('阅读个人文章', 'Read personal writing')}><ArrowUpRight size={24} stroke-width={1.3} /></a></div></div>
  </section>
  <section class="container life-page-collage" aria-label={t('日常拾页', 'Everyday fragments')}><LifeCollage /></section>

  <section class="section-space container notes-section" id="notes">
    <div class="collection-heading" data-reveal><h2>{presentation.life.notes}</h2></div>
    <div class="note-list">{notes.map((note, index) => <a class="note-row" data-reveal href={note.data.externalUrl ?? localePath(`/notes/${contentSlug(note.id)}/`, locale)} target={note.data.externalUrl ? '_blank' : undefined} rel={note.data.externalUrl ? 'noopener noreferrer' : undefined} aria-label={note.data.externalUrl ? t(`${note.data.title}，在新窗口阅读微信原文`, `${note.data.title}, read the Chinese original on WeChat in a new window`) : undefined}><span class="note-index">{String(index + 1).padStart(2, '0')}</span><span class="note-row-main"><small>{note.data.source}{note.data.externalUrl && locale === 'en' && ' · Chinese original'} / {formatDate(note.data.date, locale)}</small><strong>{note.data.title}</strong></span><span class="round-arrow"><ArrowUpRight size={25} stroke-width={1.3} /></span></a>)}</div>
    {notes.length === 0 && <p class="empty-state">{t('新的文字还在整理中。', 'New writing is on its way.')}</p>}
  </section>

  <section class="profile-index container life-index" aria-label={t('更多个人背景', 'More personal background')} data-reveal>
    <HoverDisclosure id="about" title={t('工作之外', 'Outside Work')}><div class="index-body"><p class="profile-introduction">{profile.personalIntroduction}</p><div class="interest-grid">{interests.filter((item) => item.published).map((item) => <article class="interest-card"><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></HoverDisclosure>
    <HoverDisclosure id="timeline" title={t('一路走来', 'Along the Way')}><div class="index-body"><div class="timeline">{timeline.filter((item) => item.published).map((item) => <div class="timeline-item"><span class="timeline-year">{item.year}</span><span class="timeline-marker"></span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></div></HoverDisclosure>
  </section>
</BaseLayout>
