---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtStudy from '../components/ArtStudy.astro';
import { profile, interests, timeline } from '../data/profile';
import { presentation } from '../data/presentation';
import { getPublicNotes, formatDate } from '../lib/content';
const notes = await getPublicNotes();
---

<BaseLayout title="Personal" description="马浩的生活拾页：音乐、运动、影像与经过整理的公开笔记。" section="life">
  <section class="collection-hero life-hero container">
    <div class="collection-copy hero-arrive"><p class="eyebrow">02 / PERSONAL</p><h1>{presentation.life.heading}</h1><div class="hero-bottom"><p>{presentation.life.caption}</p><a class="circle-link" href="#notes" aria-label="阅读个人文章"><ArrowUpRight size={24} stroke-width={1.3} /></a></div></div>
    <div class="hero-artwork hero-arrive"><ArtStudy kind="life" id="life-hero" /><span class="art-caption">A LITTLE ROOM FOR LIFE</span></div>
  </section>

  <section class="section-space container notes-section" id="notes">
    <div class="collection-heading" data-reveal><p class="eyebrow">JOURNAL / OPEN PAGES</p><h2>{presentation.life.notes}</h2><span>慢慢写，慢慢读。</span></div>
    <div class="note-list">{notes.map((note, index) => <a class="note-row" data-reveal href={note.data.externalUrl ?? `/notes/${note.id}/`} target={note.data.externalUrl ? '_blank' : undefined} rel={note.data.externalUrl ? 'noopener noreferrer' : undefined} aria-label={note.data.externalUrl ? `${note.data.title}，在新窗口阅读微信原文` : undefined}><span class="note-index">{String(index + 1).padStart(2, '0')}</span><span class="note-row-main"><small>{note.data.source} / {formatDate(note.data.date)}</small><strong>{note.data.title}</strong></span><span class="round-arrow"><ArrowUpRight size={25} stroke-width={1.3} /></span></a>)}</div>
    {notes.length === 0 && <p class="empty-state">新的文字还在整理中。</p>}
  </section>

  <section class="profile-index container life-index" aria-label="更多个人背景" data-reveal>
    <details class="index-disclosure" id="about"><summary><span class="index-number">01</span><span>工作之外</span><span class="index-hint">ABOUT ME</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary><div class="index-body"><p class="profile-introduction">{profile.personalIntroduction}</p><div class="interest-grid">{interests.filter((item) => item.published).map((item) => <article class="interest-card"><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></details>
    <details class="index-disclosure" id="timeline"><summary><span class="index-number">02</span><span>一路走来</span><span class="index-hint">LITTLE MOMENTS</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary><div class="index-body"><p class="profile-introduction">从项目路演、竞赛展示，到为日常写小工具，在尝试中慢慢认识自己。</p><div class="timeline">{timeline.filter((item) => item.published).map((item) => <div class="timeline-item"><span class="timeline-year">{item.year}</span><span class="timeline-marker"></span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></div></details>
  </section>
</BaseLayout>
