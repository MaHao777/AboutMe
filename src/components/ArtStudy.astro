---
interface Props { kind: 'work' | 'life'; id: string }
const { kind, id } = Astro.props;
const gradientId = `planet-fallback-${id}`;
const frontId = `orbit-front-${id}`;
const globeId = `globe-${id}`;
const palette = kind === 'work'
  ? { light: '#bbdfe6', dark: '#285487', orbit: '#749ec8', moon: '#f4e5c4' }
  : { light: '#f5d691', dark: '#a96932', orbit: '#b58b51', moon: '#fff0c8' };
---

<div class:list={['art-study', `art-${kind}`]} data-planet-scene data-kind={kind} aria-hidden="true">
  <svg class="planet-fallback" viewBox="0 0 700 600" fill="none">
    <defs>
      <radialGradient id={gradientId} cx="32%" cy="26%" r="76%">
        <stop stop-color={palette.light} />
        <stop offset="1" stop-color={palette.dark} />
      </radialGradient>
      <clipPath id={frontId}><rect x="0" y="285" width="700" height="315" /></clipPath>
      <clipPath id={globeId}><circle cx="350" cy="285" r="151" /></clipPath>
    </defs>
    <ellipse cx="350" cy="285" rx="238" ry="106" transform="rotate(-18 350 285)" stroke={palette.orbit} stroke-opacity=".65" stroke-width="2" />
    {kind === 'work' && <ellipse cx="350" cy="285" rx="210" ry="62" transform="rotate(-18 350 285)" stroke="#c3d6de" stroke-opacity=".75" stroke-width="22" />}
    <circle cx="350" cy="285" r="151" fill={`url(#${gradientId})`} />
    <g clip-path={`url(#${globeId})`}>
      {kind === 'work' ? (
        <g stroke="#d4edf0" stroke-opacity=".22" stroke-width="7" transform="rotate(-10 350 285)">
          <path d="M190 218 Q350 245 510 218 M190 250 Q350 282 510 250 M190 295 Q350 319 510 295 M190 338 Q350 358 510 338" />
        </g>
      ) : (
        <g>
          <path d="M240 146 Q290 174 331 153 Q385 188 450 165 L455 134 L230 129Z" fill="#efe5cd" fill-opacity=".8" />
          <path d="M202 271 Q260 228 307 281 T407 277 L435 327 Q369 298 321 339 T226 343Z" fill="#925f41" fill-opacity=".25" />
          <g stroke="#f0d2a3" stroke-opacity=".25" fill="#7e4d34" fill-opacity=".12" stroke-width="3">
            <circle cx="306" cy="252" r="19" /><circle cx="402" cy="315" r="28" /><circle cx="295" cy="363" r="11" />
          </g>
        </g>
      )}
    </g>
    <g clip-path={`url(#${frontId})`}>
      {kind === 'work' && <g transform="rotate(-18 350 285)" stroke="#c3d6de">
        <ellipse cx="350" cy="285" rx="210" ry="62" stroke-opacity=".75" stroke-width="22" />
        <ellipse cx="350" cy="285" rx="217" ry="64" stroke-opacity=".5" stroke-width="2" />
        <ellipse cx="350" cy="285" rx="201" ry="59" stroke-opacity=".5" stroke-width="2" />
      </g>}
      <ellipse cx="350" cy="285" rx="238" ry="106" transform="rotate(-18 350 285)" stroke={palette.orbit} stroke-opacity=".85" stroke-width="2" />
    </g>
    <circle cx="568" cy="210" r="21" fill={palette.moon} />
  </svg>
</div>

<script>
  import { mountPlanetScene } from '../lib/planetScene';

  type PlanetManager = { mount: () => void; dispose: () => void };
  const globalWindow = window as Window & { __cosmosPlanetManager?: PlanetManager };

  if (!globalWindow.__cosmosPlanetManager) {
    const scenes = new Map<HTMLElement, () => void>();
    const mount = () => {
      document.querySelectorAll<HTMLElement>('[data-planet-scene]').forEach((host) => {
        if (!scenes.has(host)) scenes.set(host, mountPlanetScene(host, host.dataset.kind === 'life' ? 'life' : 'work'));
      });
    };
    const dispose = () => {
      scenes.forEach((cleanup) => cleanup());
      scenes.clear();
    };
    globalWindow.__cosmosPlanetManager = { mount, dispose };
    document.addEventListener('astro:page-load', mount);
    document.addEventListener('astro:before-swap', dispose);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount, { once: true });
    else mount();
  }
</script>
