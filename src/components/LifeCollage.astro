---
import { ArrowUpRight, Shuffle } from '@lucide/astro';
import { getPublicNotes } from '../lib/content';
import { getSiteData } from '../data/localized';
import { getLocale, localePath, translator, contentSlug } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const notes = await getPublicNotes(locale);
const { profile, interests } = getSiteData(locale);
const music = interests.find(item => item.number === '01' && item.published);
const noteUrl = (note: typeof notes[number]) => note.data.externalUrl ?? localePath(`/notes/${contentSlug(note.id)}/`, locale);
---
<div class="life-collage" data-reveal>
  <div class="life-offline"><p class="life-lede">{profile.personalIntroduction}</p>{music && <div class="life-music"><h3>{music.title}</h3><div class="piano-keys" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <span class:list={{ 'with-black': ![2, 6, 9, 13].includes(i) }}></span>)}</div><p>{music.description}</p></div>}</div>
  <div class="life-writing"><div class="life-note-list">{notes.map(note => <a class="life-note" href={noteUrl(note)} target={note.data.externalUrl ? '_blank' : undefined} rel={note.data.externalUrl ? 'noopener noreferrer' : undefined} title={note.data.source}><time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time><h3>{note.data.title}</h3><ArrowUpRight size={21} /></a>)}</div>{notes.length > 0 && <a class="life-random" data-random-note href={noteUrl(notes[0])} target="_blank" rel="noopener noreferrer" data-notes={JSON.stringify(notes.map(noteUrl))}>{t('随机读一篇', 'A random read')}<Shuffle size={15} /></a>}</div>
</div>
<script>
  const bound = new WeakSet<Element>();
  function initializeDiscovery() {
    document.querySelectorAll<HTMLAnchorElement>('[data-random-note]').forEach(link => {
      if (bound.has(link)) return;
      bound.add(link);
      const notes: string[] = JSON.parse(link.dataset.notes ?? '[]');
      let previous = -1;
      const choose = () => {
        if (!notes.length) return;
        let index = Math.floor(Math.random() * notes.length);
        if (notes.length > 1 && index === previous) index = (index + 1) % notes.length;
        previous = index; link.href = notes[index];
      };
      choose(); link.addEventListener('click', choose); link.addEventListener('auxclick', choose);
    });
  }
  initializeDiscovery();
  document.addEventListener('astro:page-load', initializeDiscovery);
</script>
