---
import { ArrowUpRight } from '@lucide/astro';
import { getSiteData } from '../data/localized';
import { getLocale, localePath, translator } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const { profile, experiences, timeline } = getSiteData(locale);
const stages = [
  { published: timeline.some(item => item.published && item.year === t('此前', 'Earlier')), title: t('从动手开始', 'Learning by making'), description: t('在课程与竞赛里学习编程，把知识变成可以运行的程序。', 'Learning programming through coursework and competitions, turning ideas into running programs.'), detail: t('先实现一个具体功能，再从运行和修改中理解问题。', 'Starting with something concrete, then learning through running and revising it.') },
  { published: experiences.some(item => item.published && item.href.includes('vehicle-communication')), title: t('走进工程现场', 'Into the field'), description: t('企业实践把工作带到了设备和团队中。', 'Industry practice brought the work into real devices and teams.'), detail: t('接口协作、日志排查与现场联调，让“能运行”有了更具体的标准。', 'Interfaces, logs, and field integration made “working software” a more concrete standard.') },
  { published: experiences.some(item => item.published && item.href.includes('event-optics')), title: t('回到研究问题', 'Asking research questions'), description: t('在光电研究中，继续连接物理问题与软件方法。', 'Connecting physical questions with software methods through optical research.'), detail: t('关注数据从哪里来、实验能否复现、结论如何验证；也继续为日常写小工具。', 'Asking where data comes from, whether experiments can be reproduced, and how conclusions hold up; still making tools for everyday life.') },
].filter(stage => stage.published);
---
<section class="journey-section container" id="about" aria-labelledby="journey-heading">
  <div class="journey-intro" data-reveal><h2 id="journey-heading">{t('一路走来', 'Along the way')}</h2><p>{profile.school}</p><a class="editorial-link" href={localePath('/work#experience', locale)}>{t('完整经历', 'More about me')}<ArrowUpRight size={16} /></a></div>
  <div class="journey-path" data-reveal>{stages.map(stage => <details class="journey-stop" open><summary><span class="journey-dot" aria-hidden="true"></span><strong>{stage.title}</strong><span class="journey-plus" aria-hidden="true">+</span></summary><div class="journey-content"><p>{stage.description}</p><p>{stage.detail}</p></div></details>)}</div>
</section>
