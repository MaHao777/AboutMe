---
// A quiet, deterministic sky without an animation loop.
const stars = Array.from({ length: 54 }, (_, index) => ({
  x: (index * 233 + 47) % 1440,
  y: (index * 137 + 31) % 1000,
  radius: index % 9 === 0 ? 1.6 : 0.8,
  opacity: 0.25 + (index % 5) * 0.12,
}));
---

<div class="cosmic-backdrop" aria-hidden="true">
  <svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" fill="none">
    <g class="sky-stars" fill="currentColor">
      {stars.map((star) => <circle cx={star.x} cy={star.y} r={star.radius} opacity={star.opacity} />)}
    </g>
    <g class="sky-constellations" stroke="currentColor" stroke-width="0.7">
      <path d="M74 225L163 183L211 281L128 350L74 225 M163 183L259 114" />
      <path d="M1182 121L1259 203L1361 174L1310 312 M1259 203L1192 288" />
      <path d="M1087 724L1168 683L1238 746L1346 698" />
      <circle cx="163" cy="183" r="4" /><circle cx="1259" cy="203" r="4" />
    </g>
  </svg>
</div>
