---
interface Props {
  id: string;
  number: string;
  title: string;
  hint: string;
}
const { id, number, title, hint } = Astro.props;
---

<details class="index-disclosure" id={id} data-hover-disclosure>
  <summary><span class="index-number">{number}</span><span>{title}</span><span class="index-hint">{hint}</span><span class="disclosure-plus" aria-hidden="true">＋</span></summary>
  <div data-disclosure-content><slot /></div>
</details>

<script>
  const hover = matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLDetailsElement>('[data-hover-disclosure]').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const content = details.querySelector<HTMLElement>('[data-disclosure-content]')!;
    let animation: Animation | undefined;
    let expanded = details.open;
    let hovered = false;
    let touch = false;
    let keyboardFocus = false;

    // Keep `open` through the closing animation; measure the current height when
    // reversing so a quick re-entry continues smoothly instead of snapping.
    const setExpanded = (next: boolean) => {
      if (expanded === next) return;
      expanded = next;
      const start = details.getBoundingClientRect().height;
      animation?.cancel();
      details.style.height = '';
      details.open = true;
      details.dataset.expanded = String(next);
      content.inert = !next;
      const end = next ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height + 1;

      const finish = () => {
        details.open = next;
        details.style.height = '';
        details.style.overflow = '';
        animation = undefined;
      };
      if (reducedMotion.matches) {
        finish();
        return;
      }
      details.style.overflow = 'hidden';
      details.style.height = `${start}px`;
      animation = details.animate([{ height: `${start}px` }, { height: `${end}px` }], {
        duration: next ? 440 : 340,
        easing: 'cubic-bezier(.22,.7,.25,1)',
        fill: 'forwards',
      });
      animation.onfinish = () => {
        animation?.cancel();
        finish();
      };
    };

    details.dataset.expanded = String(expanded);
    content.inert = !expanded;
    details.addEventListener('pointerenter', (event) => {
      if (!hover.matches || event.pointerType !== 'mouse') return;
      hovered = true;
      setExpanded(true);
    });
    details.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      hovered = false;
      if (!keyboardFocus) setExpanded(false);
    });
    summary.addEventListener('pointerdown', (event) => { touch = event.pointerType === 'touch'; });
    summary.addEventListener('click', (event) => {
      event.preventDefault();
      // A mouse uses hover; touch and Enter/Space retain explicit controls.
      if (hover.matches && !touch && event.detail > 0) return;
      setExpanded(!expanded);
    });
    details.addEventListener('focusin', (event) => {
      if (!(event.target instanceof HTMLElement) || !event.target.matches(':focus-visible')) return;
      keyboardFocus = true;
      setExpanded(true);
    });
    details.addEventListener('focusout', (event) => {
      // activeElement can temporarily be BODY between focus events. Use the
      // announced destination so Tab into an internal link never hides it.
      if (event.relatedTarget instanceof Node && details.contains(event.relatedTarget)) return;
      keyboardFocus = false;
      if (!hovered) setExpanded(false);
    });
    reducedMotion.addEventListener('change', () => { animation?.finish(); });
  });
</script>
