---
import { ArrowUpRight } from '@lucide/astro';
import { featuredResults } from '../data/profile';
---

<section class="result-strip container" aria-label="代表成果" data-reveal>
  {featuredResults.filter((item) => item.published).map((item) => <a href={item.href} aria-label={`${item.value}，${item.label}。${item.detail}`}><strong>{item.value}</strong><span>{item.label}</span><ArrowUpRight size={18} stroke-width={1.4} /></a>)}
</section>
