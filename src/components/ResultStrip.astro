---
import { ArrowUpRight } from '@lucide/astro';
import { getSiteData } from '../data/localized';
import { getLocale, localePath, translator } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const { featuredResults } = getSiteData(locale);
---

<section class="result-strip container" aria-label={t('代表成果', 'Selected results')} data-reveal>
  {featuredResults.filter((item) => item.published).map((item) => <a href={localePath(item.href, locale)} aria-label={`${item.value}: ${item.label}. ${item.detail}`}><strong>{item.value}</strong><span>{item.label}</span><ArrowUpRight size={18} stroke-width={1.4} /></a>)}
</section>
