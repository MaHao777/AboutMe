---
import { ArrowUpRight } from '@lucide/astro';
import ProjectEvidence from './ProjectEvidence.astro';
import { getPublicProjects } from '../lib/content';
import { getProjectStories } from '../data/stories';
import { getLocale, localePath, translator, contentSlug } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const projects = await getPublicProjects(locale);
const stories = getProjectStories(locale).flatMap(story => {
  const project = projects.find(item => contentSlug(item.id) === story.slug);
  return project ? [{ ...story, project, href: localePath(`/projects/${story.slug}/`, locale) }] : [];
});
const flagship = stories.find(story => story.slug === 'event-optics');
const supporting = stories.filter(story => story.slug !== 'event-optics');
---
<section class="selected-section" id="selected-work" aria-labelledby="selected-heading">
  <div class="container selected-intro" data-reveal><h2 id="selected-heading">{t('作品选集', 'Selected work')}</h2><a class="editorial-link" href={localePath('/work#projects', locale)}>{t('全部作品', 'All work')}<ArrowUpRight size={18} /></a></div>
  {flagship && <article class="flagship-story">
    <img class="flagship-art" src={flagship.cover} alt={flagship.coverAlt} width="1600" height="1000" loading="lazy" />
    <div class="container flagship-body">
      <div class="flagship-copy" data-reveal>
        <h3><a href={flagship.href}>{t('事件视觉与', 'Event vision &')}<br />{t('波前数据平台', 'wavefront data')}</a></h3>
        <p>{flagship.description}</p>
        <a class="flagship-link" href={flagship.href}>{t('走进项目', 'Inside the project')}<ArrowUpRight size={22} /></a>
      </div>
      <div class="flagship-bottom"><div class="flagship-honors"><p>{flagship.result}</p><span>{flagship.honors[1]}</span><small>{flagship.contribution}</small></div><ProjectEvidence src={flagship.image} alt={flagship.project.data.coverAlt} caption={flagship.caption} label={flagship.evidenceLabel} width={flagship.width} height={flagship.height} /></div>
    </div>
  </article>}
  <div class="supporting-stories container">
    {supporting.map(story => <article class:list={['supporting-story', `study-${story.slug}`]} data-reveal>
      <a class="study-art" href={story.href}><img src={story.cover} alt={story.coverAlt} width={story.slug === 'traceformer' ? 1200 : 800} height={story.slug === 'traceformer' ? 790 : 920} loading="lazy" /><span class="study-open" aria-hidden="true"><ArrowUpRight size={25} /></span></a>
      <div class="study-copy"><h3><a href={story.href}>{story.title}</a></h3><p>{story.description}</p><p class="study-result">{story.result}</p><div class="study-actions"><a class="editorial-link" href={story.href}>{t('项目详情', 'Read project')}<ArrowUpRight size={17} /></a><ProjectEvidence src={story.image} alt={story.project.data.gallery.find(image => image.src === story.image)?.alt ?? story.project.data.coverAlt} caption={story.caption} label={story.evidenceLabel} width={story.width} height={story.height} /></div></div>
    </article>)}
  </div>
</section>
