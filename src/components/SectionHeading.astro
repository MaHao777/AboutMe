---
interface Props {
  index: string;
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
}
const { index, title, intro, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow"><span class="section-index">{index}</span> / {title.toUpperCase()}</p>
    <h2>{title}</h2>
    {intro && <p class="section-intro">{intro}</p>}
  </div>
  {href && <a class="text-link" href={href}>{linkLabel ?? '查看全部'} <span aria-hidden="true">↗</span></a>}
</div>
