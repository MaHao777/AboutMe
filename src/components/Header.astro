---
import { ArrowUpRight, Moon, Sun } from '@lucide/astro';
import { profile } from '../data/profile';
import { links as socialLinks } from '../data/links';
import { getLocale, localePath, translator } from '../lib/i18n';

const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
const path = localePath(Astro.url.pathname, 'zh').replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: t('首页', 'Home'), active: path === '/' },
  { href: '/work', label: t('研究与作品', 'Work'), active: path === '/work' || path.startsWith('/projects/') },
  { href: '/life', label: t('生活与文字', 'Life'), active: path === '/life' || path.startsWith('/notes/') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath('/', locale)} aria-label={t('返回首页', 'Back to home')}>
      <svg class="brand-orbit" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="8" stroke="currentColor" /><ellipse cx="20" cy="20" rx="18" ry="7" transform="rotate(-35 20 20)" stroke="currentColor" /><circle cx="33" cy="10" r="2.5" fill="currentColor" /></svg>
      <span class="brand-mark">{t(profile.name, profile.englishName)}</span>
    </a>
    <nav class="primary-nav" aria-label={t('主导航', 'Main navigation')}>
      {links.map((link) => <a href={localePath(link.href, locale)} class:list={['nav-link', { active: link.active }]} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button id="theme-toggle" class="icon-button theme-toggle" type="button" aria-label={t('切换深色模式', 'Switch to dark mode')} title={t('切换主题', 'Switch theme')} data-light-label={t('切换浅色模式', 'Switch to light mode')} data-dark-label={t('切换深色模式', 'Switch to dark mode')}>
        <Sun size={17} stroke-width={1.8} class="sun-icon" />
        <Moon size={17} stroke-width={1.8} class="moon-icon" />
      </button>
      <a class="header-github" href={socialLinks.github} target="_blank" rel="noopener noreferrer" aria-label={t('在新窗口打开 GitHub', 'Open GitHub in a new window')}>
        GitHub <ArrowUpRight size={15} stroke-width={1.8} />
      </a>
      {profile.email && <a class="header-contact" href={`mailto:${profile.email}`} aria-label={t(`通过邮件联系：${profile.email}`, `Email me: ${profile.email}`)}><span class="contact-address">{profile.email}</span><span class="contact-label">{t('联系', 'Email')}</span><ArrowUpRight size={15} stroke-width={1.8} /></a>}
      <a class="language-toggle" href={localePath(Astro.url.pathname, locale === 'zh' ? 'en' : 'zh')} hreflang={locale === 'zh' ? 'en' : 'zh-CN'} aria-label={t('切换到英文', 'Switch to Chinese')} title={t('切换到英文', 'Switch to Chinese')} data-language-switch>{t('EN', '中文')}</a>
    </div>
  </div>
</header>

<script>
  const bound = new WeakSet<Element>();
  const initializeHeader = () => {
    const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const updateLabel = () => {
      if (toggle) toggle.setAttribute('aria-label', (document.documentElement.dataset.theme === 'dark' ? toggle.dataset.lightLabel : toggle.dataset.darkLabel) ?? '');
    };
    updateLabel();
    if (toggle && !bound.has(toggle)) {
      bound.add(toggle);
      toggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0c111b' : '#f7f5ef');
        try { localStorage.setItem('theme', next); } catch { /* Theme still works without storage. */ }
        updateLabel();
      });
    }
    const languageSwitch = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
    if (languageSwitch && !bound.has(languageSwitch)) {
      bound.add(languageSwitch);
      const path = languageSwitch.pathname;
      const updateDestination = () => { languageSwitch.href = path + location.search + location.hash; };
      updateDestination();
      languageSwitch.addEventListener('click', updateDestination);
    }
  };
  initializeHeader();
  document.addEventListener('astro:page-load', initializeHeader);
</script>
