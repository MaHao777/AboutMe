---
import { getLocale, translator } from '../lib/i18n';
const t = translator(getLocale(Astro.url.pathname));
const points = Array.from({ length: 1080 }, (_, i) => {
  const column = i % 36;
  const row = Math.floor(i / 36);
  const x = (column - 17.5) / 17.5;
  const y = (row - 14.5) / 14.5;
  const wave = Math.sin(Math.hypot(x, y) * 6 - x * 2) * 18 + Math.cos(y * 4 + x * 3) * 11;
  return { x: 54 + column * 11.3 + y * 24, y: 112 + row * 6.8 + wave, warm: Math.sin(x * 3 + y * 4) > .52 };
});
---
<div class="event-field" data-event-field>
  <div class="field-visual">
    <svg class="field-wave" viewBox="0 0 500 420" fill="none" aria-hidden="true">
      {points.map(point => <circle cx={point.x} cy={point.y} r="1.5" fill={point.warm ? 'var(--field-warm)' : 'var(--field-cool)'} opacity=".7" />)}
    </svg>
    <canvas tabindex="-1" role="button" aria-label={t('互动光场：移动拨动，点击产生涟漪。键盘方向键移动，空格或回车触发。此为交互示意。', 'Interactive light field: move to bend, click for ripples. Arrow keys move; Space or Enter sends a ripple. An interactive illustration.')} aria-describedby="field-description"></canvas>
  </div>
  <div class="field-controls" data-event-controls hidden>
    <span>{t('移动拨动 · 点击涟漪', 'Move to bend · tap to ripple')}</span>
    <div role="group" aria-label={t('光场视图', 'Light field view')}>
      <button type="button" data-field-view="light" aria-pressed="true">{t('光场', 'Light')}</button>
      <button type="button" data-field-view="events" aria-pressed="false">{t('事件', 'Events')}</button>
    </div>
  </div>
  <span id="field-description" class="sr-only">{t('一个可拨动的光点曲面。事件视图用红蓝轨迹呈现曲面的变化，非真实相机数据。', 'A responsive surface of light. Event view shows its changes as red and blue traces; this is not recorded camera data.')}</span>
</div>
<script>
  import { createEventField } from '../lib/eventField';
  let cleanup: (() => void) | undefined;
  function initialize() {
    cleanup?.();
    const field = document.querySelector<HTMLElement>('[data-event-field]');
    cleanup = field ? createEventField(field) : undefined;
  }
  initialize();
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
