---
import { ArrowUpRight } from '@lucide/astro';
import { profile } from '../data/profile';
import { links } from '../data/links';
import { getLocale, localePath, translator } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = translator(locale);
---

<footer class="site-footer container">
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {t(profile.name, profile.englishName)}</span><div class="footer-links"><a href={localePath('/work', locale)}>{t('研究与作品', 'Work')}</a><a href={localePath('/life', locale)}>{t('生活与文字', 'Life')}</a>{links.published && <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={13} /></a>}</div><span class="footer-signature">{t('用心记录与创造。', 'Made with care.')}</span></div>
</footer>
