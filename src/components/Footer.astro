---
import { ArrowUpRight } from '@lucide/astro';
import { profile } from '../data/profile';
import { links } from '../data/links';
---

<footer class="site-footer container">
  <div class="footer-contact" data-reveal><p>Let’s talk<span>.</span></p>{profile.email && <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}<ArrowUpRight size={23} stroke-width={1.3} /></a>}</div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.englishName}</span><div class="footer-links"><a href="/work">Professional</a><a href="/life">Personal</a>{links.published && <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub <ArrowUpRight size={13} /></a>}</div><span class="footer-signature">Made with care.</span></div>
</footer>
