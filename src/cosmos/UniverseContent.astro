---
import { getCollection, render } from 'astro:content';
import { universeData } from './universeData';
import { awardRecords, languageScores, contacts, skillEvidence, internshipDetails } from '../data/portfolio';
import EvidenceImage from './EvidenceImage.astro';
interface Props { mode?: 'templates' | 'reading'; }
const { mode = 'templates' } = Astro.props;
const Wrapper = mode === 'templates' ? 'template' : 'section';
const projectMap: Record<string, string> = { 'event-optics': 'wavefront', 'fringe-lock': 'fringe', traceformer: 'detection' };
const projects = (await getCollection('projects', ({ data }) => data.published && data.locale === 'zh')).filter((p) => projectMap[p.id]);
const projectViews = await Promise.all(projects.map(async (project) => ({ project, ...(await render(project)) })));
const notes = (await getCollection('notes', ({ data }) => data.published && data.locale === 'zh' && !!data.externalUrl)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateLabel = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const anchors = (id: string) => mode === 'reading' ? id : undefined;
const planetIds = universeData.flatMap((p) => p.satellites.map((s) => s.detailId));
if (planetIds.length !== 17 || new Set(planetIds).size !== 17) throw new Error('COSMOS requires 17 unique satellite details');
---

<Wrapper data-content-detail="education" id={anchors('education')} class:list={['reading-entry', mode === 'templates' && 'template-entry']}><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">01 / 基本信息</p><h2>教育信息</h2><p class="detail-lede">苏州大学<br />光电科学与工程学院<br />集萃行本班 · 大三在读</p></header>
  <div class="cosmos-detail-main"><h2>我所在的学院</h2><p>光电科学与工程学院以光学工程为学科特色，围绕光电子信息开展研究与人才培养，研究领域涉及光学加工制造、纳米光子、新型显示、光电器件、光学系统与激光技术。</p><p>对我来说，光电既有物理问题，也有需要亲手实现的软件、仪器和实验。波前感知、事件相机与闭环控制，是我正在探索的几个方向。</p><a href="https://oese.suda.edu.cn/xygk/list.htm" target="_blank" rel="noopener noreferrer">学院官方介绍 ↗</a><h2>什么是集萃行本班？</h2><p>这是苏州大学与长三角国家技术创新中心合作开展的人才培养探索，率先在光电科学与工程学院试点。核心是“学行交替”：在课堂学习和产业实践之间来回，把真实工程问题带回学习。</p><div class="detail-highlights"><section><h3>双场景</h3><p>学校课堂与企业研发现场相互连接。</p></section><section><h3>双导师</h3><p>在学业指导之外，引入企业导师的工程经验。</p></section><section><h3>实践学期</h3><p>第二、第三学年累计安排约 12 个月带薪顶岗实习。</p></section></div><p>我在这一过程中参与过约四个月的企业实践，做通信测试工具、机型适配和 ROS 2 节点开发。</p><a href="https://www.suda.edu.cn/suda_news/jxky/202606/92c7e255-6414-4d52-b9fc-519b968ade23.html" target="_blank" rel="noopener noreferrer">苏州大学 · 行本教育介绍 ↗</a></div>
</article></Wrapper>

<Wrapper data-content-detail="awards" id={anchors('awards')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">01 / 基本信息</p><h2>获奖信息</h2><p class="detail-lede">学习、竞赛和实践中的阶段记录。</p><p>证书图片可点击放大。</p></header>
  <div class="cosmos-detail-main">{awardRecords.map((award) => <section class="detail-record"><small>{award.type}</small><h3>{award.title}</h3><p>{award.description}</p>{'image' in award && <EvidenceImage src={award.image} alt={award.alt} caption={award.title === '蓝桥杯江苏省一等奖' ? '证书展示副本，已遮盖证件与证书号码。' : '团队获奖证书。奖项名称按证书原文呈现。'} />}</section>)}</div>
</article></Wrapper>

<Wrapper data-content-detail="languages" id={anchors('languages')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">01 / 基本信息</p><h2>语言能力</h2><p class="detail-lede">四级 623 · 六级 606<br />高考英语 141</p></header>
  <div class="cosmos-detail-main">{languageScores.map((exam) => <section class="detail-record"><small>{exam.code} · {exam.date}</small><h3>{exam.title}<strong class="score-number">{exam.score}</strong></h3><EvidenceImage src={exam.image} alt={`${exam.title}成绩报告单，${exam.score}分，敏感号码和二维码已遮盖`} caption={`${exam.date} · 身份证号、准考证号、报告编号与校验信息已遮盖。`} /></section>)}<section class="detail-record"><small>高考英语</small><h3>141 分</h3><p>高中学习阶段的英语成绩。</p></section></div>
</article></Wrapper>

<Wrapper data-content-detail="skills" id={anchors('skills')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">01 / 基本信息</p><h2>综合能力</h2><p class="detail-lede">用做过的事，说明能做的事。</p><div class="detail-tags"><span>Python</span><span>C / C++</span><span>MATLAB</span><span>Qt</span><span>ROS 2</span><span>Git / Linux</span></div></header>
  <div class="cosmos-detail-main">{skillEvidence.map((skill) => <section class="detail-record"><h3>{skill.title}</h3><p>{skill.description}</p><EvidenceImage src={skill.image} alt={skill.alt} caption={skill.detail} /></section>)}<a href="https://github.com/MaHao777" target="_blank" rel="noopener noreferrer">更多代码与开源实践 ↗</a></div>
</article></Wrapper>

{projectViews.map(({ project, Content }) => { const d = project.data; const id = projectMap[project.id]; return <Wrapper data-content-detail={id} id={anchors(id)} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">02 / 科研经历</p><h2>{universeData[1].satellites.find((s) => s.id === id)?.title}</h2><p class="detail-lede">{d.description}</p><p class="detail-result">{d.outcome}</p><time>{dateLabel(d.date)}</time></header>
  <div class="cosmos-detail-main"><section class="detail-facts"><h3>我的贡献</h3><p>{d.role}</p><div class="detail-tags">{d.technologies.map((t) => <span>{t}</span>)}</div></section>{d.cover && <EvidenceImage src={d.cover} alt={d.coverAlt} caption={d.coverCaption ?? ''} />}<div class="cosmos-prose"><Content /></div>{d.gallery.map((item) => <EvidenceImage src={item.src} alt={item.alt} caption={item.caption} />)}{d.github && <a href={d.github} target="_blank" rel="noopener noreferrer">GitHub · 项目代码 ↗</a>}</div>
</article></Wrapper>; })}

{internshipDetails.map((item) => <Wrapper data-content-detail={item.id} id={anchors(item.id)} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">03 / 实习经历</p><h2>{item.title}</h2><p class="detail-lede">{item.subtitle}</p><p class="detail-result">{item.result}</p><p>清华大学苏州汽车研究院相关企业<br />约四个月软件开发实践</p></header>
  <div class="cosmos-detail-main"><h2>问题</h2><p>{item.problem}</p><h2>方法与我的工作</h2><ul>{item.method.map((step) => <li>{step}</li>)}</ul><h2>成果</h2><p>{item.outcome}</p>{item.id !== 'configuration' && <EvidenceImage src="/images/project-vehicle.png" alt="MQTT 通讯与 ROS 2 机器人系统业务架构图" caption="实习期间的业务架构图，展示通信链路；并非测试软件的运行截图。" />}</div>
</article></Wrapper>)}

<Wrapper data-content-detail="music" id={anchors('music')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">04 / 兴趣爱好</p><h2>音乐和钢琴</h2><p class="detail-lede">大二开始自学钢琴。</p><p>在代码和实验之外，给旋律留一点时间。</p></header>
  <div class="cosmos-detail-main"><h2>指尖的另一种表达</h2><p>会弹奏《Merry Christmas, Mr. Lawrence》等曲目。练琴是一件可以慢慢做的事，从一段旋律开始，反复练习，再把它连接完整。</p><a class="record-sleeve" href="https://music.apple.com/us/album/merry-christmas-mr-lawrence/1500818100" target="_blank" rel="noopener noreferrer"><span class="record-art"><img src="/images/merry-christmas-mr-lawrence.jpg" alt="Merry Christmas, Mr. Lawrence 原声专辑封面，来自 Apple Music" loading="lazy" referrerpolicy="no-referrer" /></span><span><small>练习曲目 · 坂本龙一</small><strong>Merry Christmas,<br />Mr. Lawrence</strong><span>专辑封面 · Apple Music ↗</span></span></a></div>
</article></Wrapper>

<Wrapper data-content-detail="basketball" id={anchors('basketball')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">04 / 兴趣爱好</p><h2>篮球</h2><p class="detail-lede">八年球龄。</p><p>球场是日常的一部分。</p></header><div class="cosmos-detail-main"><h2>下一场，还想继续打</h2><p>从一个人的投篮练习，到和朋友一起打球，篮球一直陪伴着我的生活。喜欢运动本身，也喜欢球场上的配合和交流。</p><div class="basketball-motif" aria-hidden="true"><span></span><b>SEE YOU<br />ON THE COURT.</b></div></div>
</article></Wrapper>

<Wrapper data-content-detail="writing" id={anchors('writing')} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">04 / 兴趣爱好</p><h2>写作</h2><p class="detail-lede">我的微信公众号文章。</p><p>把日常、工具和实践，写成自己的文字。</p></header><div class="cosmos-detail-main">{notes.map((note) => <section class="detail-record"><small>微信公众号 · {dateLabel(note.data.date)}</small><h3><a href={note.data.externalUrl} target="_blank" rel="noopener noreferrer">{note.data.title} ↗</a></h3><p>{note.data.description}</p><a href={note.data.externalUrl} target="_blank" rel="noopener noreferrer">阅读公众号原文 ↗</a></section>)}</div>
</article></Wrapper>

{contacts.map((contact) => <Wrapper data-content-detail={contact.id} id={anchors(contact.id)} class="reading-entry"><article class="cosmos-detail-document">
  <header class="cosmos-detail-heading"><p class="detail-kicker">05 / 联系方式</p><h2>{contact.title}</h2><p class="detail-lede contact-value">{contact.value}</p></header><div class="cosmos-detail-main"><h2>打个招呼</h2><p>{contact.description}</p><div class="detail-contact">{'href' in contact ? <a class="contact-action" href={contact.href} target={contact.id === 'github' ? '_blank' : undefined} rel={contact.id === 'github' ? 'noopener noreferrer' : undefined}>{contact.action} ↗</a> : <div><button class="contact-action" type="button" data-copy-contact={contact.value}>复制微信号 ↗</button><p role="status" data-copy-status></p></div>}</div></div>
</article></Wrapper>)}
